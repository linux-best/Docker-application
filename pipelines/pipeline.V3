pipeline {
    agent any

    environment { // health-check // log-file // dovcker-var // git-repo
	    SCAN_VAR = "SCANNING"
    }

    stages {
        stage('Checkout-SCM') {
            steps {
                echo "stage Checkout-SCM passed"
            }
        }
        stage('Trivy-Repository'){
            stages {
                stage('Initialize SCAN') {
                    steps {
                        echo "Trivy is searching for Vulnerabilities in REPOSITORY"
                        echo "==========================${env.SCAN_VAR}============================"
                    }
                }
                stage('Scanning') {
                    parallel {   
                        stage('REPO') {
                            steps {
                                script {
                                    def Test_1 = sh(script:"ping -c 4 8.8.8.8",stdout=true).trim()
                                    echo "${Test_1}"
                                }
                            }
                        }
                        stage('DOKERFILE') {
                            steps {
                                script {
                                    def Test_2 = sh(script:"ping -c 4 127.0.0.1",stdout=true).trim()
                                    echo "${Test_2}"
                                }
                            }
                        }
            }
                }
            }
        }
        stage('Build') {
            steps {
		        echo "stage Build passed"
            }
        }
        stage('Trivy-Image') { // sec-gate
            steps {
		        echo "stage Tricy_Image passed"
            }
        }
        stage('Test') {
            steps {
		        echo "stage Test passed"
            }
        }
        stage('Trivy-Container') { // sec-gate
            steps {
		        echo "stage Trivy_Container passed"
            }
        }
        stage('Deploy') {
            steps {
		        echo "stage Deploy passed"
            }
        }
    }
    post {
        always {
            echo "Task Done ."
        }
        success {
            echo "Task was Successful !!"
        }
        failure {
            echo "Task was failed !!!"
        }
    }
}
